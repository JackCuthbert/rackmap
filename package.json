{
  "name": "homelab-visualizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/server/main.ts --dev",
    "start": "bun run src/server/main.ts",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json",
    "lint": "oxlint --type-aware --no-error-on-unmatched-pattern",
    "fmt": "oxfmt --no-error-on-unmatched-pattern package.json vite.config.ts src scripts",
    "fmt:check": "oxfmt --check --no-error-on-unmatched-pattern package.json vite.config.ts src scripts",
    "schema:generate": "bun run scripts/generate-schema.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.1",
    "elkjs": "^0.11.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "^1.3.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
